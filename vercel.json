{
    "rewrites": [
        {
            "source": "/privacy",
            "destination": "/privacy.html"
        },
        {
            "source": "/terms",
            "destination": "/terms.html"
        },
        {
            "source": "/delete-info",
            "destination": "/delete-info.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}