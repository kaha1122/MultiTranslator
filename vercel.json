{
    "ignoreCommand": "bash scripts/vercel-ignore.sh",
    "installCommand": "PUPPETEER_SKIP_DOWNLOAD=1 npm install",
    "rewrites": [
        {
            "source": "/privacy",
            "destination": "/privacy.html"
        },
        {
            "source": "/terms",
            "destination": "/terms.html"
        },
        {
            "source": "/delete-info",
            "destination": "/delete-info.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
